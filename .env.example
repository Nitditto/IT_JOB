# ==========================================
# IT_JOB Environment Template (.env.example)
# Copy this file to .env and fill in real values
# ==========================================

# Application Ports & Services
FRONTEND_URL=http://localhost:5173
BACKEND_PORT=8080

# PostgreSQL Database Configuration
POSTGRES_DB=it_job
POSTGRES_USER=itjob
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_PORT=5432

# Database Connection (Spring Boot / JDBC)
SPRING_DATASOURCE_URL=jdbc:postgresql://database:5432/it_job
SPRING_DATASOURCE_USERNAME=itjob
SPRING_DATASOURCE_PASSWORD=your_secure_db_password_here

# JWT Security & Admin Settings
JWT_SECRET=your_jwt_secret_key_base64_encoded
ADMIN_INITIAL_PASSWORD=your_admin_initial_password

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate limit store: memory (default) or redis (shared across instances)
RATE_LIMIT_STORE=memory

# Gemini AI (called from the backend; leave empty to disable AI features -> /ai/generate returns 503)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash